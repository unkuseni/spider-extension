# --- Spider Cloud (https://spider.cloud/api-keys) ---
SPIDER_API_KEY=sp_...
# SPIDER_API_BASE=https://api.spider.cloud
# Extract mode: auto (try Spider AI, fall back to local), local, spider
SPIDER_EXTRACT=auto
SPIDER_CRAWL_LIMIT=30
SPIDER_CRAWL_DEPTH=2
# Premium proxy pool (residential rotation) for bot-protected sites — costs more.
# SPIDER_PROXY=true
# Target a country for proxy georouting (ISO-2, e.g. us, de, gb).
# SPIDER_COUNTRY=us

# --- Turso (https://turso.tech) ---
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=eyJ...

# --- Plunk (https://docs.useplunk.com) --- email verification
PLUNK_API_KEY=sk_...
# PLUNK_API_BASE=https://next-api.useplunk.com
# Verify emails automatically after hunting?
VERIFY_ON_HUNT=true

# --- Employee email discovery (inferred emails) ---
# Infer employee emails for people without a published address: learn the domain's
# pattern (first.last, firstlast, ...), generate candidates, verify with Plunk.
GUESS_EMAILS=false
# Max candidate addresses to try per person (default 3)
GUESS_PER_PERSON=3
# GitHub org discovery (opt-in, e.g. --github vercel): raise the public-API rate limit
# from ~60 req/h to 5000/h. Optional.
# GITHUB_TOKEN=ghp_...
# GitHub API base (override for tests/proxies; default https://api.github.com)
# GITHUB_API_BASE=https://api.github.com

# --- AI (any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, LM Studio...) ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# DeepSeek works too (OpenAI-compatible):
# OPENAI_API_KEY=sk-...  (key from https://platform.deepseek.com)
# OPENAI_BASE_URL=https://api.deepseek.com   (or https://api.deepseek.com/v1)
# OPENAI_MODEL=deepseek-chat                   (JSON mode)
# OPENAI_MODEL=deepseek-v4-flash               (function calling — best for agent mode)
# OPENAI_MODEL=deepseek-reasoner               (reasoning; no json mode, no function calling)