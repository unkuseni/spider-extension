{
  "manifest_version": 3,
  "name": "Spider — Web Scraper & Crawler",
  "version": "1.0.0",
  "description": "Scrape any page, crawl entire sites, and extract clean web data — powered by Spider Cloud.",
  "author": "spider-rs",
  "homepage_url": "https://spider.cloud",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "spider@spider.cloud",
      "strict_min_version": "112.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.spider.cloud/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://next-api.useplunk.com/*",
    "https://*.turso.io/*",
    "http://localhost:*/*",
    "https://*.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.indeed.com/*",
    "https://*.workday.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Spider — Scrape or Crawl",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Spider popup"
    },
    "scrape-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Quick-scrape the current page"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Open Spider side panel"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
